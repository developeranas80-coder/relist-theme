<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_accent }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    {{ content_for_header }}

    <!-- Fonts Load (Aesthetic Serif and Modern Sans) -->
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500;600&family=Outfit:wght@300;400;500;600&family=Space+Grotesk:wght@600;700&family=Syne:wght@600;700;800&display=swap" rel="stylesheet">

    <!-- CSS Variable Mapping from Shopify Settings -->
    <style>
      :root {
        --primary-bg: {{ settings.color_primary_bg | default: '#faf6f0' }};
        --secondary-bg: {{ settings.color_secondary_bg | default: '#f0eae1' }};
        --accent-color: {{ settings.color_accent | default: '#8e745a' }};
        --text-color: {{ settings.color_text | default: '#2b2825' }};
        
        --font-heading: {{ settings.font_heading | default: "'Cormorant Garamond', serif" }};
        --font-body: {{ settings.font_body | default: "'Outfit', sans-serif" }};
        
        --grid-gap: 30px;
        --card-border-width: {% if settings.card_style == 'boxed' %}1px{% else %}0px{% endif %};
      }
      
      body {
        background-color: var(--primary-bg);
        color: var(--text-color);
        font-family: var(--font-body);
        margin: 0;
        padding: 0;
        -webkit-font-smoothing: antialiased;
      }
    </style>

    {{ 'theme.css' | asset_url | stylesheet_tag }}
  </head>

  <body>
    <!-- Premium Editorial Preloader Screen -->
    <div class="preloader-overlay" id="preloader-overlay">
      <div class="preloader-background-vignette"></div>
      <div class="preloader-grid-lines"></div>

      <!-- Architectural Corner Header Info -->
      <div class="preloader-corner preloader-top-left">
        <div class="preloader-status-indicator">
          <span class="preloader-status-dot"></span>
          <span class="preloader-meta-label">RELIST ARCHIVE ®</span>
        </div>
        <span class="preloader-meta-sub">AUTUMN / WINTER 2026</span>
      </div>

      <div class="preloader-corner preloader-top-right">
        <span class="preloader-meta-label">EST. 2026</span>
        <span class="preloader-meta-sub">TOKYO • PARIS • NEW YORK</span>
      </div>

      <!-- Center High-Fashion Typography & Emblem -->
      <div class="preloader-center-content">
        <div class="preloader-emblem-wrapper">
          <svg class="preloader-emblem-svg" width="64" height="64" viewBox="0 0 64 64" fill="none">
            <circle cx="32" cy="32" r="30" stroke="currentColor" stroke-width="1" stroke-dasharray="4 4" class="emblem-dash-ring" />
            <path d="M32 10 L32 54 M10 32 L54 32" stroke="currentColor" stroke-width="1" opacity="0.3" />
            <polygon points="32,18 43,32 32,46 21,32" fill="none" stroke="currentColor" stroke-width="1.5" class="emblem-diamond" />
            <circle cx="32" cy="32" r="3" fill="currentColor" class="emblem-core" />
          </svg>
        </div>
        <div class="preloader-brand-title">
          <span class="brand-char">R</span>
          <span class="brand-char">E</span>
          <span class="brand-char">L</span>
          <span class="brand-char">I</span>
          <span class="brand-char">S</span>
          <span class="brand-char">T</span>
        </div>
        <p class="preloader-subtitle">EDITORIAL FASHION & LUXURY ARCHIVE</p>
      </div>

      <!-- Bottom Left Dynamic Ticker -->
      <div class="preloader-bottom-left">
        <span class="preloader-ticker-label">[ STATUS ]</span>
        <span class="preloader-ticker-text" id="preloader-ticker">INITIALIZING HIGH-RES ASSETS...</span>
      </div>

      <!-- Bottom Right 1-100 Loading Counter & Line -->
      <div class="preloader-bottom-right">
        <div class="preloader-counter-wrapper">
          <span class="preloader-counter-number" id="preloader-counter">001</span>
          <span class="preloader-counter-symbol">%</span>
        </div>
        <div class="preloader-progress-track">
          <div class="preloader-progress-bar" id="preloader-progress-bar"></div>
          <div class="preloader-progress-glow-dot" id="preloader-glow-dot"></div>
        </div>
      </div>
    </div>

    <!-- Cart Drawer Snippet -->
    {% render 'cart-drawer' %}

    <div class="page-container">
      <!-- Header Section Group (OS 2.0 Header) -->
      {% section 'header' %}

      <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
        {{ content_for_layout }}
      </main>

      {% section 'instagram-feed' %}

      <!-- Footer Section Group (OS 2.0 Footer) -->
      {% section 'footer' %}
    </div>

    <!-- Theme JS Asset -->
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
