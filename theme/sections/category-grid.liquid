<section class="category-cards-section">
  <div class="category-cards-grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="category-card" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}">
        {%- else -%}
          <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background:#eee; font-size:11px; color:#888; aspect-ratio:3/4;">No Image Assigned</div>
        {%- endif -%}
        <span class="category-card-label">{{ block.settings.title | escape }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Category Cards Grid",
  "max_blocks": 12,
  "settings": [],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Name",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Cards Grid",
      "blocks": [
        { "type": "category", "settings": { "title": "T-Shirts" } },
        { "type": "category", "settings": { "title": "Shirts" } },
        { "type": "category", "settings": { "title": "Dresses" } },
        { "type": "category", "settings": { "title": "Denim" } },
        { "type": "category", "settings": { "title": "Skirts & Shorts" } },
        { "type": "category", "settings": { "title": "Trousers" } }
      ]
    }
  ]
}
{% endschema %}
