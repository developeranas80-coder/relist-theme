<section class="featured-collection-section">
  <div class="section-header">
    <div class="section-meta">
      {%- if section.settings.title != blank -%}
        <h2>{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p>{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="product-grid">
    {%- assign current_collection = collections[section.settings.collection] -%}
    {%- for product in current_collection.products limit: section.settings.products_to_show -%}
      {%- render 'product-card', product: product -%}
    {%- else -%}
      {%- comment -%} Fallback placeholder items for when no collection is assigned {%- endcomment -%}
      {%- for i in (1..section.settings.products_to_show) -%}
        <div class="product-card card-style-minimal">
          <div class="card-media">
            <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background:#eee; font-size:11px; opacity:0.4;">Placeholder {{ i }}</div>
          </div>
          <div class="card-details">
            <h3 class="card-title">Atelier Sample Piece</h3>
            <div class="card-price-wrapper">
              <span class="card-price-current">$190.00</span>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Selected Pieces"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Meticulously structured essentials"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Number of Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Featured Collection Grid",
      "category": "Collection"
    }
  ]
}
{% endschema %}
