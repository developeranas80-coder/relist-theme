<footer class="store-footer">
  <div class="footer-grid">
    {%- for block in section.blocks -%}
      <div class="footer-col" {{ block.shopify_attributes }}>
        {%- case block.type -%}
          {%- when 'text' -%}
            <h4>{{ block.settings.heading | escape }}</h4>
            <p>{{ block.settings.subtext }}</p>
            
          {%- when 'link_list' -%}
            <h4>{{ block.settings.heading | escape }}</h4>
            <ul class="footer-links">
              {%- for link in linklists[block.settings.menu].links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
            
          {%- when 'newsletter' -%}
            <h4>{{ block.settings.heading | escape }}</h4>
            <p>{{ block.settings.subtext }}</p>
            {%- form 'customer', class: 'newsletter-form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <input type="email" name="contact[email]" class="newsletter-input" placeholder="Email address" required>
              <button type="submit" class="newsletter-btn">Subscribe</button>
            {%- endform -%}
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>
  
  <div class="footer-bottom">
    <span>&copy; {{ 'now' | date: "%Y" }} {{ shop.name }} Atelier. All rights reserved.</span>
    <span>Powered by Shopify. Theme designed by Relist Custom.</span>
  </div>
</footer>

{% schema %}
{
  "name": "Footer Section",
  "max_blocks": 4,
  "settings": [],
  "blocks": [
    {
      "type": "text",
      "name": "Text Panel",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "About Relist"
        },
        {
          "type": "textarea",
          "id": "subtext",
          "label": "Text",
          "default": "An editorial storefront offering organic textiles, ethical wool, and bias-cut satins. Crafting minimal silhouettes that elevate daily dress."
        }
      ]
    },
    {
      "type": "link_list",
      "name": "Menu Links",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Navigation"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter Signup",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Join the Mailing"
        },
        {
          "type": "textarea",
          "id": "subtext",
          "label": "Description",
          "default": "Register for notification of limited run atelier drops, seasonal capsules, and essays on form."
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "text" },
      { "type": "link_list" },
      { "type": "newsletter" }
    ]
  }
}
{% endschema %}
