<section class="lookbook-section">
  {%- if section.settings.title != blank -%}
    <h2 class="lookbook-section-title">{{ section.settings.title | escape }}</h2>
  {%- endif -%}
  <div class="lookbook-grid">
    {%- for block in section.blocks limit: 3 -%}
      {%- assign card_size = 'size-small' -%}
      {%- if forloop.first -%}
        {%- assign card_size = 'size-large' -%}
      {%- endif -%}

      <a href="{{ block.settings.link | default: '#' }}" class="lookbook-card {{ card_size }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 1000 }}" alt="{{ block.settings.title | escape }}">
        {%- else -%}
          <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background:#eee; font-size:12px; color:#888;">No Image Assigned</div>
        {%- endif -%}
        <div class="lookbook-content">
          {%- if block.settings.subtitle != blank -%}
            <span class="lookbook-tag">{{ block.settings.subtitle | escape }}</span>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h3>{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.btn_label != blank -%}
            <span class="lookbook-btn">{{ block.settings.btn_label | escape }}</span>
          {%- endif -%}
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Lookbook Grid",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Streetwear Lookbook"
    }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Lookbook Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Sub-heading / Tag",
          "default": "Volume 01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Campaign Look"
        },
        {
          "type": "text",
          "id": "btn_label",
          "label": "Button Label",
          "default": "Explore the Edit"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook Grid",
      "blocks": [
        { "type": "look", "settings": { "title": "Utility Techwear", "subtitle": "Volume 01" } },
        { "type": "look", "settings": { "title": "Street Coats", "subtitle": "Winter Edit" } },
        { "type": "look", "settings": { "title": "Cargo Essentials", "subtitle": "Midsummer Capsule" } }
      ]
    }
  ]
}
{% endschema %}
