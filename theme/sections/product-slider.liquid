<section class="product-slider-section" id="section-{{ section.id }}">
  <div class="slider-section-header">
    {%- if section.settings.title != blank -%}
      <h2 class="slider-section-title">{{ section.settings.title }}</h2>
    {%- endif -%}
    <div class="slider-nav-arrows">
      <button class="slider-arrow slider-prev" data-slider="{{ section.id }}" aria-label="Previous">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button class="slider-arrow slider-next" data-slider="{{ section.id }}" aria-label="Next">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
  </div>

  <div class="product-slider-track" id="slider-{{ section.id }}">
    {%- assign slider_collection = collections[section.settings.collection] -%}
    {%- for product in slider_collection.products limit: section.settings.products_to_show -%}
      {%- render 'product-card', product: product -%}
    {%- else -%}
      {%- comment -%} Fallback items {%- endcomment -%}
      {%- for i in (1..6) -%}
        <div class="product-card card-style-minimal">
          <div class="card-media">
            <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background:#eee; font-size:11px; opacity:0.4;">Sample Item {{ i }}</div>
          </div>
          <div class="card-details">
            <h3 class="card-title">Relist Sample</h3>
            <div class="card-price-wrapper">
              <span class="card-price-current">PKR 2,490</span>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.show_view_all and slider_collection != blank -%}
    <div class="slider-view-all">
      <a href="{{ slider_collection.url }}" class="view-all-link">View All</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product Slider",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 15,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' Link",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Product Slider",
      "category": "Collection"
    }
  ]
}
{% endschema %}
