<section class="promo-banners-section">
  <div class="promo-banners-grid">
    {%- for block in section.blocks limit: 2 -%}
      <a href="{{ block.settings.link | default: '#' }}" class="promo-banner-card" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.label | escape }}">
        {%- else -%}
          <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background:#eee; font-size:13px; color:#888; aspect-ratio:4/5;">No Image Assigned</div>
        {%- endif -%}
        <div class="promo-banner-overlay">
          <span class="promo-banner-label">{{ block.settings.label | escape }}</span>
          <span class="promo-banner-cta">{{ block.settings.cta_text | default: 'Shop Now →' }}</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Side-by-Side Banners",
  "max_blocks": 2,
  "settings": [],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Banner Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Heading",
          "default": "Dresses"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Button Label",
          "default": "Shop Now →"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Side-by-Side Banners",
      "blocks": [
        { "type": "banner", "settings": { "label": "Dresses" } },
        { "type": "banner", "settings": { "label": "Shirts" } }
      ]
    }
  ]
}
{% endschema %}
